# Server
PORT=3001
MONGO_URI=mongodb://localhost:27017/fleetpulse
JWT_SECRET=change-me-in-production-use-long-random-string
DEVICE_KEY=fleet-device-secret-key

# Simulator
SIM_BUS_COUNT=200
SIM_EVENT_RATE_HZ=2
SIM_EMBEDDED=false
SIM_SERVER_URL=http://localhost:3001

# Performance tuning
FLUSH_INTERVAL_MS=250
TICK_RATE_MS=100
HIGH_WATER_MARK=500
DEDUPE_CACHE_SIZE=50000
RATE_LIMIT_PER_DEVICE=50
RATE_LIMIT_GLOBAL=50000

# CORS
CLIENT_URL=http://localhost:5173

# Logging
LOG_LEVEL=info
